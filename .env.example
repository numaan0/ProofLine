# Meta Model API (backend/.env). MODEL_API_KEY is the documented name; META_API_KEY also works.
MODEL_API_KEY=your_meta_model_api_key_here

# Optional overrides
# META_SPARK_MODEL=muse-spark-1.3
# META_SAM_MODEL=sam-3.1
# GUARD_ENABLE_SEMANTIC_PREFLIGHT=true

# Email summaries (optional). Without SMTP_HOST, summaries are kept in data/outbox/ and shown in the report.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=ProofLine <reports@example.com>
# APP_URL=http://localhost:5173
